#!/usr/bin/env bash
# 测试替身：模拟 `codex mcp get lanhu-mcp`，返回一条指向不存在路径的注册记录。
# 凭据一律用占位符，不得出现真实值。
if [ "${1:-}" = "mcp" ] && [ "${2:-}" = "get" ] && [ "${3:-}" = "lanhu-mcp" ]; then
  cat <<'EOF'
lanhu-mcp
  enabled: true
  transport: stdio
  command: /usr/bin/node
  args: /nonexistent/lanhu-mcp-server/dist/index.js
  cwd: -
  env: LANHU_AUTHORIZATION=*****, LANHU_COOKIE=*****
  remove: codex mcp remove lanhu-mcp
EOF
  exit 0
fi
exit 1
